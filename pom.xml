		<name>MCHV Apache Maven Packages</name>
		<url>https://mvn.mchv.eu/repository/mchv/</url>
	</repository>
</repositories>
	<dependencyManagement>
		<dependencies>
			<!-- Импортируем BOM, который сам сопоставит нужные версии -->
			<dependency>
				<groupId>it.tdlight</groupId>
				<artifactId>tdlight-java-bom</artifactId>
				<version>3.5.4+td.1.8.66</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<description/>
	<url/>
	<licenses>
		<license/>
